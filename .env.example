APP_NAME=billing-agent
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
MAX_REQUEST_BODY_BYTES=8192
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/billing_agent
DATABASE_ECHO=false

LLM_MODEL=billing-local
LLM_TIMEOUT_SECONDS=10
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-service-dev
FLIGHTDECK_UI_BASE_URL=https://flightdeck.example.com
LITELLM_MASTER_KEY=sk-litellm-master-change-me
LITELLM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billing_agent
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://host.docker.internal:11434
UI_USERNAME=admin
UI_PASSWORD=change-me

MCP_SERVER_URL=http://localhost:9000/mcp
MCP_TIMEOUT_SECONDS=5
MCP_CLIENT_MODE=local
MCP_SERVICE_TOKEN=dev-mcp-token
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_BACKOFF_SECONDS=0.2
MCP_CIRCUIT_BREAKER_THRESHOLD=3
MCP_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

AUTO_CREDIT_LIMIT=25.00
MAX_CREDIT_LIMIT=500.00
SUPPORTED_CURRENCY=USD
MAX_MESSAGE_LENGTH=2000

AUTH_MODE=api_key
AUTH_INTROSPECTION_URL=
AUTH_INTROSPECTION_TIMEOUT_SECONDS=5
AUTH_INTROSPECTION_CLIENT_ID=
AUTH_INTROSPECTION_CLIENT_SECRET=
AUTH_ROLE_CLAIM=roles
AUTH_SCOPE_CLAIM=scope
AUTH_READ_ROLE=billing.read
AUTH_WRITE_ROLE=billing.write
AUTH_APPROVE_ROLE=billing.approve
AUTH_ADMIN_ROLE=billing.admin

AUTH_READ_KEY=dev-read-key
AUTH_WRITE_KEY=dev-write-key
AUTH_APPROVE_KEY=dev-approve-key
AUTH_ADMIN_KEY=dev-admin-key
